# Server Config
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/gst-invoice-app

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay Config
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# The chat assistant is switched off. Set true (and SHOW_ASSISTANT in
# client/src/lib/flags.js) to bring it back.
ASSISTANT_ENABLED=false
# Used only when it is on: a Claude key (paid API), model and daily question limit
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=60

# Frontend address allowed to call this API in production (no trailing slash)
CLIENT_URL=

# Password reset by email. Leave blank to switch it off. Set one key:
#   Resend (resend.com): MAIL_FROM must be on a domain you have verified.
#   Brevo (brevo.com):   MAIL_FROM must be a sender address you have verified.
RESEND_API_KEY=
BREVO_API_KEY=
MAIL_FROM=

# Number of proxies in front of the server; used by the sign-in attempt limits
TRUST_PROXY=1
