# Server Config
PORT=5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/gst-invoice-app

# JWT Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Razorpay Config
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Assistant: leave blank to use the built-in commands.
# With a key, questions are answered by Claude (a paid API).
ANTHROPIC_API_KEY=
# Optional, used only with a key: model and per-user daily question limit
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=60

# Frontend address allowed to call this API in production (no trailing slash)
CLIENT_URL=
